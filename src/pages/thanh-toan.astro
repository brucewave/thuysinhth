---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { site } from '../data/site.js';
---
<Base title="Đặt hàng">
  <Crumbs items={[{ name: 'Đặt hàng' }]} />
  <div class="checkout" data-checkout hidden>
    <form novalidate data-endpoint={site.orderEndpoint} data-zalo={site.zalo}>
      <h1>Đặt hàng</h1>
      <ul class="checkout-promise">
        <li>Chưa cần thanh toán ở bước này</li>
        <li>{site.name} liên hệ xác nhận đơn trước khi giao</li>
      </ul>

      <h2>Liên hệ</h2>
      <div class="field-row">
        <label class="field">
          <span>Họ và tên</span>
          <input name="name" autocomplete="name" required />
          <em hidden>Vui lòng nhập họ và tên.</em>
        </label>
        <label class="field">
          <span>Số điện thoại</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="(\+84|0)[0-9 .]{8,12}" />
          <em hidden>Vui lòng nhập số điện thoại hợp lệ, ví dụ 0901234567.</em>
        </label>
      </div>

      <h2>Giao hàng</h2>
      <label class="field">
        <span>Địa chỉ nhận hàng</span>
        <input name="address" autocomplete="street-address" placeholder="Số nhà, đường, phường/xã, tỉnh/thành phố" required />
        <em hidden>Vui lòng nhập địa chỉ nhận hàng.</em>
      </label>
      <label class="field">
        <span>Ghi chú (không bắt buộc)</span>
        <textarea name="note" rows="2"></textarea>
      </label>
      <label class="check">
        <input type="checkbox" name="remember" />
        <span>Lưu thông tin và đơn này trên máy này cho lần sau</span>
      </label>
      <button class="btn full" type="submit">{site.orderEndpoint ? 'Gửi đơn hàng' : 'Tiếp tục'}</button>
    </form>

    <aside class="checkout-side" aria-label="Tóm tắt đơn hàng">
      <div class="checkout-summary">
        <div class="checkout-summary-head">
          <h2>Đơn hàng</h2>
          <button type="button" class="link-more" data-open-cart>Sửa giỏ hàng</button>
        </div>
        <ul class="checkout-lines" data-lines></ul>

        <section class="checkout-more" data-more hidden>
          <h3>Đừng quên mua thêm</h3>
          <ul data-more-list></ul>
        </section>

        <dl class="checkout-totals">
          <div><dt>Tạm tính</dt><dd data-subtotal></dd></div>
          <div><dt>Phí giao hàng</dt><dd>Báo khi xác nhận đơn</dd></div>
          <div class="grand"><dt>Tổng tiền hàng</dt><dd data-total></dd></div>
        </dl>
      </div>
    </aside>
  </div>

  <div class="wrap checkout-state">
    <p class="note" data-empty hidden>Giỏ hàng đang trống. <a href="/san-pham/">Xem sản phẩm</a></p>

    <div data-done hidden>
      <p class="note" data-done-text></p>
      <div data-manual hidden>
        <textarea class="order-text" readonly aria-label="Nội dung đơn hàng"></textarea>
        <div class="stack">
          <button class="btn" type="button" data-copy>Sao chép nội dung đơn</button>
          {site.zalo && <a class="btn alt" href={`https://zalo.me/${site.zalo}`} target="_blank" rel="noopener">Mở Zalo</a>}
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { addOrder, cartLines, cartTotal, clearCart, loadProfile, moreProducts, saveProfile } from '../scripts/store.js';

  const $ = (s) => document.querySelector(s);
  const form = $('form[data-endpoint]');
  const money = (n) => n.toLocaleString('vi-VN') + ' VNĐ';

  function render() {
    const lines = cartLines();
    if ($('[data-done]').hidden === false) return;
    $('[data-empty]').hidden = lines.length > 0;
    $('[data-checkout]').hidden = lines.length === 0;
    const list = $('[data-lines]');
    list.replaceChildren(
      ...lines.map((l) => {
        const li = document.createElement('li');
        li.innerHTML = '<span class="line-thumb"><img alt="" width="64" height="64"><b></b></span><span class="line-name"><strong></strong><small></small></span><span class="line-price"></span>';
        li.querySelector('img').src = l.image;
        li.querySelector('b').textContent = l.qty;
        li.querySelector('strong').textContent = l.name;
        li.querySelector('small').textContent = `${l.size} · Số lượng ${l.qty}`;
        li.querySelector('.line-price').textContent = money(l.total);
        return li;
      }),
    );

    const more = moreProducts().slice(0, 2);
    $('[data-more]').hidden = !more.length;
    $('[data-more-list]').replaceChildren(
      ...more.map(([slug, p]) => {
        const li = document.createElement('li');
        li.innerHTML = '<img alt="" width="64" height="64" loading="lazy"><span class="line-name"><a></a><span class="price"></span></span><button class="btn" type="button" data-quiet>Thêm</button>';
        li.querySelector('img').src = p.image;
        const link = li.querySelector('a');
        link.href = `/san-pham/${slug}/`;
        link.textContent = p.name;
        li.querySelector('.price').textContent = money(p.price);
        const button = li.querySelector('button');
        button.dataset.add = slug;
        button.setAttribute('aria-label', `Thêm ${p.name} vào đơn`);
        return li;
      }),
    );

    $('[data-subtotal]').textContent = money(cartTotal());
    $('[data-total]').textContent = money(cartTotal());
  }

  function validate() {
    let firstBad;
    form.querySelectorAll('[required]').forEach((f) => {
      const ok = f.value.trim() !== '' && f.checkValidity();
      f.closest('.field').querySelector('em').hidden = ok;
      f.setAttribute('aria-invalid', !ok);
      if (!ok && !firstBad) firstBad = f;
    });
    firstBad?.focus();
    return !firstBad;
  }

  function orderText(data, lines) {
    return [
      'ĐƠN HÀNG THỦY SINH TH',
      ...lines.map((l) => `- ${l.name} (${l.size}) x ${l.qty}: ${money(l.total)}`),
      `Tạm tính: ${money(cartTotal())}`,
      `Họ tên: ${data.name}`,
      `SĐT: ${data.phone}`,
      `Địa chỉ: ${data.address}`,
      data.note ? `Ghi chú: ${data.note}` : '',
    ]
      .filter(Boolean)
      .join('\n');
  }

  function finish(message, manualText) {
    $('[data-checkout]').hidden = true;
    $('[data-done]').hidden = false;
    $('[data-done-text]').textContent = message;
    $('[data-manual]').hidden = !manualText;
    if (manualText) $('.order-text').value = manualText;
    window.scrollTo(0, 0);
  }

  const profile = loadProfile();
  if (profile) {
    for (const key of ['name', 'phone', 'address']) form.elements[key].value = profile[key] ?? '';
    form.elements.remember.checked = true;
  }

  form.addEventListener('input', (e) => {
    const em = e.target.closest('.field')?.querySelector('em');
    if (em && !em.hidden && e.target.checkValidity()) em.hidden = true;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    const data = Object.fromEntries(new FormData(form));
    const lines = cartLines();
    const text = orderText(data, lines);
    const endpoint = form.dataset.endpoint;

    if (data.remember) {
      saveProfile({ name: data.name, phone: data.phone, address: data.address });
      addOrder(lines, cartTotal());
    }
    delete data.remember;

    if (!endpoint) {
      const channel = form.dataset.zalo ? `qua Zalo ${form.dataset.zalo}` : 'cho cửa hàng';
      return finish(`Bước cuối: sao chép nội dung đơn dưới đây rồi gửi ${channel} để hoàn tất đặt hàng.`, text);
    }

    const button = form.querySelector('[type=submit]');
    button.disabled = true;
    button.textContent = 'Đang gửi...';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ ...data, items: lines, total: cartTotal(), text }),
      });
      if (!res.ok) throw new Error(res.status);
      clearCart();
      finish('Đã nhận đơn hàng. Cảm ơn bạn, cửa hàng sẽ sớm liên hệ để xác nhận.');
    } catch {
      finish('Chưa gửi được đơn. Vui lòng sao chép nội dung dưới đây và gửi cho cửa hàng.', text);
    }
  });

  $('[data-copy]').addEventListener('click', async (e) => {
    try {
      await navigator.clipboard.writeText($('.order-text').value);
      e.target.textContent = 'Đã sao chép';
    } catch {
      $('.order-text').select();
    }
  });

  document.addEventListener('cart:change', render);
  render();
</script>
