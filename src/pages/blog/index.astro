---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts.js';
---
<Base title="Blog về bể cá" description="Kiến thức nuôi cá cảnh đơn giản, đúng khoa học dành cho người mới bắt đầu.">
  <Crumbs items={[{ name: 'Blog' }]} />
  <div class="wrap">
    <h1 class="page-title">Blog về bể cá</h1>
    <div class="grid posts">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</Base>
