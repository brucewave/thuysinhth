---
// Trang mở từ nút "Chia sẻ" ở chi tiết sản phẩm: bố cục điện thoại, tông màu kiểu TikTok Shop.
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import '../../styles/tiktok.css';
import mark from '../../assets/brand/mark.png';
import { site } from '../../data/site.js';
import { products, money } from '../../data/products.js';
import { ratingOf } from '../../data/reviews.js';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;
const images = p.images ?? [];
const review = ratingOf(p);
const productUrl = `/san-pham/${p.slug}/`;
const zaloUrl = `https://zalo.me/${site.zalo}`;
const ogImage = images[0] ? (await getImage({ src: images[0].src, width: 1000, format: 'jpg' })).src : undefined;
const stars = (n) => `width:${(n / 5) * 100}%`;
---
<Base title={p.name} description={p.intro?.[0].slice(0, 155)} image={ogImage} bare>
  <link slot="head" rel="canonical" href={new URL(productUrl, Astro.site ?? Astro.url).href} />
  <meta slot="head" name="theme-color" content="#ffffff" />

  <div class="tt">
    <header class="tt-top">
      <a class="tt-icon" href={productUrl} aria-label="Xem trang sản phẩm đầy đủ">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
      </a>
      <a class="tt-brand" href="/">
        <Image src={mark} alt="" width={56} format="webp" />
        {site.name}
      </a>
      <button class="tt-icon" type="button" data-share={p.slug} data-share-title={p.name} aria-label="Chia sẻ sản phẩm">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 5V2l7 7-7 7v-3.5C8 12.5 5 15 3 20c.5-6.5 4-11 11-12z"/></svg>
      </button>
      <button class="tt-icon" type="button" data-open-cart aria-label="Mở giỏ hàng">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.5l2.2 11h10.6L20.5 7.5H6.3"/><circle cx="9.5" cy="19.5" r="1.4"/><circle cx="16.5" cy="19.5" r="1.4"/></svg>
        <span class="cart-count" hidden>0</span>
      </button>
    </header>

    <div class="tt-gallery">
      <div class="tt-slides" data-tt-slides>
        {images.length ? images.map((img, i) => (
          <Image src={img.src} alt={img.alt} widths={[420, 640, 900]} sizes="(max-width: 480px) 100vw, 480px" format="webp" loading={i ? 'lazy' : 'eager'} />
        )) : <Image class="tt-placeholder" src={mark} alt="" width={320} format="webp" />}
      </div>
      {images.length > 1 && (
        <>
          <button class="tt-nav prev" type="button" data-tt-go="-1" aria-label="Ảnh trước">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <button class="tt-nav next" type="button" data-tt-go="1" aria-label="Ảnh sau">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <span class="tt-counter" aria-hidden="true"><span data-tt-index>1</span>/{images.length}</span>
        </>
      )}
    </div>
    {images.length > 1 && (
      <div class="tt-thumbs">
        {images.map((img, i) => (
          <button type="button" data-tt-thumb={i} aria-label={`Xem ảnh ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}>
            <Image src={img.src} alt="" width={144} format="webp" />
          </button>
        ))}
      </div>
    )}
    {p.tempPhoto && <p class="tt-note">Ảnh minh họa, không phải sản phẩm thật.</p>}

    <section class="tt-card tt-main">
      <p class="tt-price">{p.soldOut ? 'Sắp ra mắt' : money(p.price)}</p>
      <h1>{p.name}</h1>
      {review.count > 0 && (
        <a class="tt-rating" href="#tt-danh-gia">
          <span class="tt-stars" aria-hidden="true"><span style={stars(review.rating)}>★★★★★</span>★★★★★</span>
          <strong>{review.rating}</strong>
          <span>({review.count} đánh giá)</span>
        </a>
      )}
      <ul class="tt-badges">
        <li>Sản xuất tại Việt Nam</li>
        <li>Giao toàn quốc</li>
        {site.shipping > 0 && <li>Phí ship {money(site.shipping)}</li>}
      </ul>
    </section>

    {p.headline && (
      <p class="tt-card tt-highlight">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2s7 7.6 7 12.4A7 7 0 0 1 5 14.4C5 9.6 12 2 12 2Z"/></svg>
        {p.headline}
      </p>
    )}

    {!p.soldOut && (
      <button class="tt-card tt-row" type="button" data-tt-option>
        <span>Phân loại</span>
        <strong>{p.size}</strong>
        <span class="tt-qty-label">x<span data-tt-qty-text>1</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
      </button>
    )}

    {review.count > 0 && (
      <section class="tt-card" id="tt-danh-gia">
        <div class="tt-head">
          <h2>Đánh giá của khách hàng ({review.count})</h2>
          <a href={`${productUrl}#danh-gia`}>Xem thêm</a>
        </div>
        {review.sample && <p class="tt-note">Đánh giá mẫu để demo giao diện, không phải khách hàng thật.</p>}
        {review.list.slice(0, 2).map((r) => (
          <article class="tt-review">
            <div class="tt-who">
              <span class="tt-avatar" aria-hidden="true">{r.name[0]}</span>
              <div>
                <strong>{r.name}</strong>
                <span class="tt-stars small" aria-label={`${r.stars} sao`}><span style={stars(r.stars)}>★★★★★</span>★★★★★</span>
                <small>Phân loại: {p.size}</small>
              </div>
            </div>
            <p>{r.text}</p>
            {r.photo && <Image class="tt-review-photo" src={r.photo} alt="Ảnh hồ cá minh họa" width={240} format="webp" />}
          </article>
        ))}
      </section>
    )}

    <section class="tt-card tt-shop">
      <span class="tt-shop-logo"><Image src={mark} alt="" width={96} format="webp" /></span>
      <div>
        <strong>{site.name}</strong>
        <small>{site.tagline}{site.tiktokStats && ` · ${site.tiktokStats}`}</small>
      </div>
      <a class="tt-ghost" href="/">Truy cập</a>
    </section>

    <section class="tt-card tt-desc">
      <h2>Giới thiệu về sản phẩm này</h2>
      <div class="tt-desc-body" data-tt-more>
        {p.bullets?.length > 0 && <ul class="tt-checks">{p.bullets.map((b) => <li>{b}</li>)}</ul>}
        {p.intro?.map((t) => <p>{t}</p>)}
        {p.specs && (
          <>
            <h3>{p.specsTitle}</h3>
            <ul>{p.specs.map((s) => <li>{s}</li>)}</ul>
          </>
        )}
        {p.soldOut && <p>Sản phẩm này chưa mở bán. Nhắn <a href={zaloUrl}>Zalo</a> để được báo khi có hàng.</p>}
      </div>
      <button class="tt-more" type="button" data-tt-more-btn aria-expanded="false">Xem thêm</button>
    </section>

    <nav class="tt-bar" aria-label="Mua hàng">
      <a class="tt-bar-icon" href="/">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5 5.5 4h13L20 9.5"/><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"/><path d="M5.5 12.5V20h13v-7.5"/></svg>
        Cửa hàng
      </a>
      <a class="tt-bar-icon" href={zaloUrl} target="_blank" rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
        Chat
      </a>
      {p.soldOut ? (
        <a class="tt-btn tt-buy" href={zaloUrl} target="_blank" rel="noopener">Nhắn Zalo khi có hàng</a>
      ) : (
        <>
          <button class="tt-btn tt-add" type="button" data-add={p.slug} data-pdp="1">Thêm vào giỏ hàng</button>
          <button class="tt-btn tt-buy" type="button" data-add={p.slug} data-pdp="1" data-quiet data-buy-now>Mua ngay</button>
        </>
      )}
    </nav>

    {!p.soldOut && (
      <dialog class="tt-sheet" data-tt-sheet aria-label="Chọn số lượng">
        <div class="tt-sheet-head">
          <Image src={images[0]?.src ?? mark} alt="" width={160} format="webp" />
          <div>
            <p class="tt-price">{money(p.price)}</p>
            <small>Phân loại: {p.size}</small>
          </div>
          <button class="tt-icon" type="button" data-tt-close aria-label="Đóng">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
          </button>
        </div>
        <div class="tt-sheet-row">
          <span>Số lượng</span>
          <div class="tt-stepper">
            <button type="button" data-tt-step="-1" aria-label="Giảm số lượng">−</button>
            <input data-pdp-qty value="1" readonly aria-label="Số lượng" />
            <button type="button" data-tt-step="1" aria-label="Tăng số lượng">+</button>
          </div>
        </div>
        <button class="tt-btn tt-buy full" type="button" data-tt-close>Xác nhận</button>
      </dialog>
    )}
  </div>
</Base>

<script>
  import { shareProduct } from '../../scripts/share.js';

  document.querySelectorAll('[data-share]').forEach((b) => b.addEventListener('click', () => shareProduct(b)));

  // Ảnh trượt ngang bằng tay, bộ đếm và ảnh nhỏ đi theo.
  const track = document.querySelector('[data-tt-slides]');
  const index = document.querySelector('[data-tt-index]');
  const thumbs = document.querySelectorAll('[data-tt-thumb]');
  if (index) {
    track.addEventListener(
      'scroll',
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        index.textContent = i + 1;
        thumbs.forEach((t, n) => t.setAttribute('aria-current', n === i));
      },
      { passive: true },
    );
    const count = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i) => track.scrollTo({ left: ((i + count) % count) * track.clientWidth, behavior: 'smooth' });
    thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    document.querySelectorAll('[data-tt-go]').forEach((b) => b.addEventListener('click', () => go(current() + Number(b.dataset.ttGo))));

    // Chuột không vuốt được như ngón tay: kéo ảnh bằng chuột, thả ra thì sang ảnh gần nhất theo hướng kéo.
    let drag = null;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, left: track.scrollLeft, start: current(), moved: false };
      track.classList.add('dragging');
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (Math.abs(dx) > 4) drag.moved = true;
      track.scrollLeft = drag.left - dx;
    });
    const end = (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const target = Math.abs(dx) > track.clientWidth * 0.15 ? drag.start + (dx < 0 ? 1 : -1) : drag.start;
      track.classList.remove('dragging');
      drag = null;
      track.scrollTo({ left: Math.max(0, Math.min(count - 1, target)) * track.clientWidth, behavior: 'smooth' });
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
    track.addEventListener('dragstart', (e) => e.preventDefault());

    // Phím mũi tên khi đang chọn ảnh.
    track.tabIndex = 0;
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
  }

  // Bảng chọn số lượng; số lượng này dùng cho cả "Thêm vào giỏ" và "Mua ngay".
  const sheet = document.querySelector('[data-tt-sheet]');
  const qty = document.querySelector('[data-pdp-qty]');
  const qtyText = document.querySelector('[data-tt-qty-text]');
  if (sheet) {
    document.querySelector('[data-tt-option]').addEventListener('click', () => sheet.showModal());
    sheet.querySelectorAll('[data-tt-close]').forEach((b) => b.addEventListener('click', () => sheet.close()));
    sheet.addEventListener('click', (e) => e.target === sheet && sheet.close());
    sheet.querySelectorAll('[data-tt-step]').forEach((b) =>
      b.addEventListener('click', () => {
        qty.value = Math.max(1, Number(qty.value) + Number(b.dataset.ttStep));
        qtyText.textContent = qty.value;
      }),
    );
  }

  // store.js đã thêm vào giỏ (data-quiet nên không mở giỏ), chỉ còn chuyển sang trang đặt hàng.
  document.querySelector('[data-buy-now]')?.addEventListener('click', () => setTimeout(() => (location.href = '/chia-se/thanh-toan/')));

  const more = document.querySelector('[data-tt-more]');
  const moreBtn = document.querySelector('[data-tt-more-btn]');
  more.classList.add('collapsed');
  if (more.scrollHeight <= more.clientHeight + 40) {
    more.classList.remove('collapsed');
    moreBtn.hidden = true;
  }
  moreBtn.addEventListener('click', () => {
    const collapsed = more.classList.toggle('collapsed');
    moreBtn.textContent = collapsed ? 'Xem thêm' : 'Thu gọn';
    moreBtn.setAttribute('aria-expanded', !collapsed);
  });
</script>

<style is:global>

  .tt-brand { flex: 1; display: flex; align-items: center; gap: 8px; min-width: 0; color: var(--tt-ink); font-weight: 800; text-decoration: none; }
  .tt-brand img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }

  .tt-gallery { position: relative; background: #fff; }
  .tt-slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 1; }
  .tt-slides::-webkit-scrollbar { display: none; }
  .tt-slides img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start; }
  .tt-slides { cursor: grab; }
  .tt-slides.dragging { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; }
  .tt-slides.dragging img { pointer-events: none; }
  .tt-slides img { user-select: none; -webkit-user-drag: none; }
  .tt-nav { position: absolute; top: 50%; display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / .85); color: var(--tt-ink); box-shadow: 0 2px 8px rgb(0 0 0 / .15); transform: translateY(-50%); opacity: 0; transition: opacity .2s; }
  .tt-nav.prev { left: 10px; }
  .tt-nav.next { right: 10px; }
  .tt-gallery:hover .tt-nav, .tt-nav:focus-visible { opacity: 1; }
  @media (hover: none) { .tt-nav { opacity: 1; width: 32px; height: 32px; background: rgb(255 255 255 / .7); } }
  .tt-slides .tt-placeholder { object-fit: contain; padding: 18%; }
  .tt-counter { position: absolute; right: 12px; bottom: 12px; padding: 2px 10px; border-radius: 12px; background: rgb(0 0 0 / .45); color: #fff; font-size: 12px; font-weight: 600; }
  .tt-thumbs { display: flex; gap: 6px; padding: 8px 12px; background: #fff; overflow-x: auto; }
  .tt-thumbs button { flex: none; width: 56px; height: 56px; padding: 0; border: 2px solid transparent; border-radius: 6px; overflow: hidden; background: none; }
  .tt-thumbs button[aria-current='true'] { border-color: var(--tt-red); }
  .tt-thumbs img { width: 100%; height: 100%; object-fit: cover; }

  .tt-main { margin-top: 0; padding-top: 10px; }
  .tt h1 { margin: 6px 0 0; font-size: 1.02rem; font-weight: 600; line-height: 1.45; }
  .tt-rating { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; color: var(--tt-ink); font-size: 13px; text-decoration: none; }
  .tt-rating > span:last-child { color: var(--tt-muted); }
  .tt-stars { position: relative; display: inline-block; color: #dcdce0; font-size: 14px; letter-spacing: 1px; line-height: 1; }
  .tt-stars > span { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--tt-gold); white-space: nowrap; }
  .tt-stars.small { font-size: 12px; }
  .tt-badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; padding: 0; list-style: none; }
  .tt-badges li { padding: 2px 8px; border-radius: 4px; background: var(--tt-pink); color: var(--tt-red-dark); font-size: 12px; font-weight: 600; }

  .tt-highlight { display: flex; align-items: center; gap: 8px; color: #b26a00; font-size: 13px; font-weight: 600; }
  .tt-highlight svg { color: var(--tt-gold); flex: none; }

  .tt-row { display: flex; align-items: center; gap: 10px; width: 100%; border: 0; text-align: left; font-size: 14px; }
  .tt-row span:first-child { color: var(--tt-muted); }
  .tt-row strong { flex: 1; font-weight: 600; }
  .tt-qty-label { color: var(--tt-muted); }

  .tt-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tt-head a { color: var(--tt-muted); font-size: 13px; text-decoration: none; white-space: nowrap; }
  .tt-head a::after { content: ' ›'; }
  .tt-note { margin: 8px 0 0; color: var(--tt-muted); font-size: 12px; }
  .tt > .tt-note { padding: 0 16px 8px; background: #fff; margin: 0; }
  .tt-review { padding-top: 14px; }
  .tt-review + .tt-review { margin-top: 14px; border-top: 1px solid var(--tt-line); }
  .tt-who { display: flex; gap: 10px; }
  .tt-who > div { display: grid; gap: 2px; }
  .tt-who strong { font-size: 13px; }
  .tt-who small { color: var(--tt-muted); font-size: 12px; }
  .tt-avatar { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #2b2d38; color: #fff; font-size: 14px; font-weight: 800; flex: none; }
  .tt-review p { margin: 8px 0 0; font-size: 14px; }
  .tt-review-photo { width: 96px; height: 96px; margin-top: 8px; border-radius: 6px; object-fit: cover; }

  .tt-shop { display: flex; align-items: center; gap: 12px; }
  .tt-shop > div { flex: 1; min-width: 0; display: grid; }
  .tt-shop small { color: var(--tt-muted); font-size: 12px; }
  .tt-shop-logo { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 1px solid var(--tt-line); flex: none; }
  .tt-shop-logo img { width: 100%; height: 100%; object-fit: cover; }
  .tt-ghost { padding: 6px 14px; border: 1px solid var(--tt-line); border-radius: 4px; color: var(--tt-ink); font-size: 13px; font-weight: 600; text-decoration: none; }

  .tt-desc-body { margin-top: 10px; font-size: 14px; }
  .tt-desc-body.collapsed { max-height: 260px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  .tt-desc-body p { margin: 0 0 10px; }
  .tt-desc-body h3 { margin: 14px 0 6px; font-size: 14px; }
  .tt-desc-body ul { margin: 0 0 10px; padding-left: 20px; }
  .tt-desc-body a { color: var(--tt-red); }
  .tt-checks { list-style: none; padding: 0 !important; }
  .tt-checks li { position: relative; padding-left: 22px; margin-bottom: 4px; }
  .tt-checks li::before { content: '✓'; position: absolute; left: 0; color: var(--tt-red); font-weight: 800; }
  .tt-more { display: block; width: 100%; margin-top: 6px; padding: 8px; border: 0; background: none; color: var(--tt-muted); font-size: 13px; font-weight: 600; }

  .tt-bar { position: fixed; bottom: 0; left: 50%; z-index: 30; display: flex; align-items: center; gap: 6px; width: min(480px, 100%); padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); transform: translateX(-50%); background: #fff; border-top: 1px solid var(--tt-line); }
  .tt-bar-icon { display: grid; justify-items: center; gap: 1px; width: 46px; white-space: nowrap; letter-spacing: -.2px; color: var(--tt-ink); font-size: 10px; text-decoration: none; flex: none; }

  .tt-sheet { position: fixed; inset: auto 0 0; width: min(480px, 100%); max-width: none; margin: 0 auto; padding: 16px; border: 0; border-radius: 14px 14px 0 0; }
  .tt-sheet::backdrop { background: rgb(0 0 0 / .5); }
  .tt-sheet-head { display: flex; gap: 12px; align-items: flex-start; }
  .tt-sheet-head > div { flex: 1; }
  .tt-sheet-head img { width: 88px; height: 88px; border-radius: 6px; object-fit: cover; }
  .tt-sheet-head small { color: var(--tt-muted); }
  .tt-sheet-row { display: flex; justify-content: space-between; align-items: center; margin: 18px 0; font-weight: 600; }
  .tt-stepper { display: flex; border: 1px solid var(--tt-line); border-radius: 4px; }
  .tt-stepper button { width: 34px; height: 32px; border: 0; background: #f6f6f7; font-size: 18px; }
  .tt-stepper input { width: 44px; border: 0; text-align: center; }
</style>
