---
import { Image, getImage } from 'astro:assets';
import '../styles/global.css';
import mark from '../assets/brand/mark.png';
import menuNuoc from '../assets/khu-clo/rot.png';
import menuThucAn from '../assets/thuc-an/khoi-gel.png';
import menuViSinh from '../assets/vi-sinh/ngon-tay.png';
import menuLoc from '../assets/blog/be-ca-1.jpg';
import menuBlog from '../assets/blog/be-ca-2.jpg';
import { site } from '../data/site.js';
import { categories, products } from '../data/products.js';
import { posts } from '../data/posts.js';

const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;

const catalog = { products: {}, search: [] };
for (const p of products) {
  catalog.search.push({ title: p.name, url: `/san-pham/${p.slug}/`, type: p.soldOut ? 'Sản phẩm · Sắp ra mắt' : 'Sản phẩm' });
  if (p.soldOut) continue;
  const img = await getImage({ src: p.images[0]?.src ?? mark, width: 144, format: 'webp' });
  catalog.products[p.slug] = { name: p.name, price: p.price, size: p.size, image: img.src };
}
for (const p of posts) catalog.search.push({ title: p.title, url: `/blog/${p.slug}/`, type: 'Bài viết' });

const megaMenu = [
  {
    title: 'XỬ LÝ NƯỚC',
    url: '/danh-muc/xu-ly-nuoc/',
    image: menuNuoc,
    links: [{ name: 'Dung dịch khử Clo', url: '/san-pham/dung-dich-khu-clo/' }],
  },
  {
    title: 'THỨC ĂN & THUỐC',
    url: '/danh-muc/thuc-an/',
    image: menuThucAn,
    links: [
      { name: 'Thức ăn cho cá', url: '/danh-muc/thuc-an/' },
      { name: 'Thuốc cho cá', url: '/danh-muc/thuoc-cho-ca/' },
    ],
  },
  {
    title: 'VI SINH',
    url: '/danh-muc/vi-sinh/',
    image: menuViSinh,
    links: [{ name: 'Bột vi sinh bào tử', url: '/san-pham/bot-vi-sinh-bao-tu/' }],
  },
  {
    title: 'LỌC & PHÂN NƯỚC',
    url: '/danh-muc/loc-oxy/',
    image: menuLoc,
    links: [
      { name: 'Lọc & Oxy', url: '/danh-muc/loc-oxy/' },
      { name: 'Phân nước', url: '/danh-muc/phan-nuoc/' },
    ],
  },
  {
    title: 'KIẾN THỨC',
    url: '/blog/',
    image: menuBlog,
    links: [
      { name: 'Nuôi cá quá dễ', url: `/blog/${posts[0].slug}/` },
      { name: 'Clo, cho ăn và Cycle', url: `/blog/${posts[1].slug}/` },
    ],
  },
];

const footerIcon = {
  phone: '<path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8.500 10.500h7"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  video: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/>',
  pin: '<path d="M12 21s7-6.500 7-12a7 7 0 0 0-14 0c0 5.500 7 12 7 12Z"/><circle cx="12" cy="9" r="2.500"/>',
};
const footerContacts = [
  site.phone && { icon: 'phone', text: site.phone, url: `tel:${site.phone.replace(/\s/g, '')}` },
  site.zalo && { icon: 'chat', text: 'Zalo', url: `https://zalo.me/${site.zalo}` },
  site.email && { icon: 'mail', text: site.email, url: `mailto:${site.email}` },
  site.facebook && { icon: 'chat', text: 'Facebook', url: site.facebook },
  site.tiktok && { icon: 'video', text: 'TikTok', url: site.tiktok },
  site.address && { icon: 'pin', text: site.address },
].filter(Boolean);

const hasContact =site.phone || site.zalo || site.email || site.address || site.facebook || site.tiktok;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#0a509f" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Bỏ qua đến nội dung</a>
    <header class="site-header">
      <div class="wrap header-main">
        <a class="logo" href="/" aria-label={`${site.name}, về trang chủ`}>
          <span class="logo-mark"><Image src={mark} alt="" width={84} format="webp" /></span>
          <div>
            <strong>THỦY SINH TH</strong>
            <span>{site.tagline}</span>
          </div>
        </a>
        <form class="search" role="search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <input type="search" placeholder="Tìm sản phẩm, bài viết" aria-label="Tìm sản phẩm, bài viết" autocomplete="off" />
          <ul class="search-results" hidden></ul>
        </form>
        <div class="promise">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2s7 7.6 7 12.4A7 7 0 0 1 5 14.4C5 9.6 12 2 12 2Z"/></svg>
          <div><strong>Sản xuất tại Việt Nam</strong><span>Nuôi cá đúng khoa học</span></div>
        </div>
        <div class="header-actions">
          <button class="icon-btn menu-btn" type="button" aria-label="Mở menu" aria-expanded="false">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <a class="icon-btn" href="/tai-khoan/" aria-label="Tài khoản">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1-4 4-6 7.5-6s6.500 2 7.500 6"/></svg>
          </a>
          <button class="icon-btn" type="button" data-open-cart aria-label="Mở giỏ hàng">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.5l2.2 11h10.6L20.5 7.5H6.3"/><circle cx="9.5" cy="19.5" r="1.4"/><circle cx="16.5" cy="19.5" r="1.4"/></svg>
            <span class="cart-count" hidden>0</span>
          </button>
        </div>
      </div>
      <nav class="site-nav" aria-label="Chính">
        <ul class="wrap">
          <li><a href="/">Trang chủ</a></li>
          <li class="has-mega">
            <a class="mega-toggle" href="/san-pham/" aria-haspopup="true">Cửa hàng</a>
            <div class="mega">
              <div class="wrap mega-grid">
                {megaMenu.map((col) => (
                  <div class="mega-col">
                    <a class="mega-photo" href={col.url} tabindex="-1" aria-hidden="true">
                      <Image src={col.image} alt="" width={420} format="webp" />
                    </a>
                    <a class="mega-pill" href={col.url}>{col.title}</a>
                    <ul>{col.links.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          </li>
          <li><a href="/danh-muc/thuc-an/">Thức ăn</a></li>
          <li><a href="/danh-muc/xu-ly-nuoc/">Xử lý nước</a></li>
          <li><a href="/danh-muc/vi-sinh/">Vi sinh</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/lien-he/">Liên hệ</a></li>
        </ul>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <div class="footer-wave" aria-hidden="true">
      <svg class="wave wave-back" viewBox="0 0 2880 70" preserveAspectRatio="none"><path d="M0 35c240 0 240-30 480-30s240 30 480 30 240-30 480-30 240 30 480 30 240-30 480-30 240 30 480 30v35H0z"/></svg>
      <svg class="wave wave-front" viewBox="0 0 2880 70" preserveAspectRatio="none"><path d="M0 45c240 0 240-22 480-22s240 22 480 22 240-22 480-22 240 22 480 22 240-22 480-22 240 22 480 22v25H0z"/></svg>
    </div>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="logo" href="/" aria-label={`${site.name}, về trang chủ`}>
              <span class="logo-mark"><Image src={mark} alt="" width={84} format="webp" /></span>
              <div>
                <strong>THỦY SINH TH</strong>
                <span>{site.tagline}</span>
              </div>
            </a>
            <p>Khử Clo, thức ăn gel và vi sinh bào tử sản xuất tại Việt Nam, cùng kiến thức nuôi cá đơn giản, đúng khoa học.</p>
            <ul class="footer-badges">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2s7 7.600 7 12.400A7 7 0 0 1 5 14.400C5 9.600 12 2 12 2Z"/></svg>
                Sản xuất tại Việt Nam
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                Nuôi cá đúng khoa học
              </li>
            </ul>
          </div>
          <div>
            <h2>Cửa hàng</h2>
            <ul>{categories.slice(0, 4).map((c) => <li><a href={`/danh-muc/${c.slug}/`}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h2>Kiến thức</h2>
            <ul>
              <li><a href="/blog/">Blog về bể cá</a></li>
              <li><a href={`/blog/${posts[0].slug}/`}>Nuôi cá quá dễ</a></li>
              <li><a href={`/blog/${posts[1].slug}/`}>Clo, cho ăn và Cycle</a></li>
            </ul>
          </div>
          <div>
            <h2>Liên hệ</h2>
            <ul class="footer-contacts">
              {footerContacts.map((c) => {
                const Tag = c.url ? 'a' : 'span';
                return (
                  <li>
                    <Tag href={c.url}>
                      <span class="footer-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcon[c.icon]}></svg>
                      </span>
                      {c.text}
                    </Tag>
                  </li>
                );
              })}
              {!hasContact && <li><a href="/lien-he/">Trang liên hệ</a></li>}
            </ul>
          </div>
        </div>
        <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>

    <dialog id="cart" aria-labelledby="cart-title">
      <div class="cart-head">
        <h2 id="cart-title">Giỏ hàng</h2>
        <button class="icon-btn" type="button" data-close-cart aria-label="Đóng giỏ hàng">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </button>
      </div>
      <ul class="cart-items"></ul>
      <div class="cart-foot" hidden>
        <div class="cart-total"><span>Tạm tính</span><span data-cart-total></span></div>
        <a class="btn full" href="/thanh-toan/">Đặt hàng</a>
      </div>
    </dialog>

    <script type="application/json" id="catalog" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')}></script>
    <script>
      import '../scripts/store.js';

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) import('../scripts/motion.js');
    </script>
    <slot name="scripts" />
  </body>
</html>
