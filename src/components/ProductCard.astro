---
import { Image } from 'astro:assets';
import Rating from './Rating.astro';
import mark from '../assets/brand/mark.png';
import { money } from '../data/products.js';

const { product: p, eager = false } = Astro.props;
const photo = p.images?.[0];
---
<article class="product-card">
  <a class="product-link" href={`/san-pham/${p.slug}/`}>
    <div class="product-photo">
      {photo ? (
        <Image src={photo.src} alt={photo.alt} widths={[280, 420, 560]} sizes="(max-width: 900px) 50vw, 290px" format="webp" loading={eager ? 'eager' : 'lazy'} />
      ) : (
        <Image class="placeholder" src={mark} alt="" width={240} format="webp" />
      )}
      {p.tempPhoto && <span class="temp-tag">Ảnh minh họa</span>}
    </div>
    <div class="product-info">
      <h3>{p.name}</h3>
      {p.size && <small>{p.size}</small>}
      {!p.soldOut && <div class="rating"><Rating product={p} /></div>}
      <span class="price">{p.soldOut ? 'Sắp ra mắt' : money(p.price)}</span>
    </div>
  </a>
  {!p.soldOut && (
    <button class="add-btn" type="button" data-add={p.slug} aria-label={`Thêm ${p.name} vào giỏ`}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8V6.5a4 4 0 0 1 8 0V8"/><path d="M12 21H6.5a2 2 0 0 1-2-2.2L5.4 8h13.2l.5 5.5"/><path d="M18 16v6M15 19h6"/></svg>
      <span>Thêm vào giỏ</span>
    </button>
  )}
</article>
